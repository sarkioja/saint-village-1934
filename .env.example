# =============================================================================
#  Provedor de LLM — escolha UM
# =============================================================================
# claude | openai | openrouter | opencode
LLM_PROVIDER=claude

# -- claude: Anthropic nativa -------------------------------------------------
# É o único com prompt caching, que corta ~2/3 da entrada por turno.
# Prefira-o se tiver a chave.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-5-5       # "rápido"  — US$ 0,10/MTok in, 0,50 out
CLAUDE_MODEL_QUALITY=claude-sonnet-5-5   # "apurado" — US$ 2,00/MTok in, 10,00 out

# -- openai -------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_QUALITY=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# -- openrouter (centenas de modelos, inclusive Claude) -----------------------
OPENROUTER_API_KEY=
# OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5
# OPENROUTER_MODEL_QUALITY=anthropic/claude-sonnet-4.5
# Opcionais, para atribuição no painel do OpenRouter:
# OPENROUTER_SITE_URL=https://seu-app.vercel.app
# OPENROUTER_APP_NAME=Saint Village XX Century

# -- opencode: qualquer endpoint OpenAI-compatível ----------------------------
# OpenCode Zen, Vercel AI Gateway, Ollama, LM Studio...
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_API_KEY=
# OPENCODE_MODEL_FAST=
# OPENCODE_MODEL_QUALITY=

# =============================================================================
#  Dados
# =============================================================================
# fs       grava em .data/ — desenvolvimento e servidor próprio.
#          NÃO funciona em serverless: lá as contas se desligam sozinhas.
# postgres qualquer Postgres (Neon, Supabase, Railway, RDS, o seu).
#          O driver é escolhido pela URL: HTTP no Neon, `pg` nos demais.
DATA_BACKEND=fs
DATABASE_URL=
# DATA_DRIVER=              # force "neon" ou "pg" se a detecção pela URL errar
# SV_DATA_DIR=.data         # só para DATA_BACKEND=fs

# =============================================================================
#  Sessão
# =============================================================================
# 32+ caracteres:  openssl rand -base64 32
AUTH_SECRET=

# =============================================================================
#  Controle de custo
# =============================================================================
DAILY_TURNS_PER_USER=50
DEMO_TURNS_PER_IP=5
BOOK_CONTEXT_CHARS=11000   # maior bloco do prompt; 6000 corta ~1.400 tokens/turno
HISTORY_TURNS=18           # entradas do log enviadas como histórico
