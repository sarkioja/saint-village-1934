# ---- Provider de LLM --------------------------------------------------------
LLM_PROVIDER=claude                    # claude | opencode

# Provider 1: Anthropic nativo (Messages API, com prompt caching)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-5-5     # "rapido"  — US$ 0,10/MTok in, 0,50 out
CLAUDE_MODEL_QUALITY=claude-sonnet-5-5 # "apurado" — US$ 2,00/MTok in, 10,00 out

# Provider 2: qualquer endpoint OpenAI-compativel
# (OpenCode Zen, Vercel AI Gateway, OpenRouter, Ollama, LM Studio...)
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_MODEL_FAST=
OPENCODE_MODEL_QUALITY=

# ---- Dados ------------------------------------------------------------------
DATA_BACKEND=fs                        # fs (local) | neon (producao)
DATABASE_URL=                          # injetada pelo Marketplace da Vercel
SV_DATA_DIR=.data                      # so' para DATA_BACKEND=fs

# ---- Sessao -----------------------------------------------------------------
AUTH_SECRET=                           # 32+ chars: openssl rand -base64 32

# ---- Controle de custo ------------------------------------------------------
DAILY_TURNS_PER_USER=50
DEMO_TURNS_PER_IP=5
BOOK_CONTEXT_CHARS=11000               # maior bloco do prompt; 6000 corta ~1.400 tokens/turno
HISTORY_TURNS=18                       # entradas do log enviadas como historico
